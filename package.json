{
  "name": "git-authors",
  "version": "1.0.0",
  "description": "Code ownership analysis for git repos — who owns what, how much, and how it changed",
  "main": "dist/index.js",
  "bin": {
    "git-authors": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "code-ownership",
    "blame",
    "authors",
    "analysis",
    "cli"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/git-authors"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*.js",
    "!dist/test/**"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
